# Title storage service (block 20230 in ports.md). Copy to .env, fill in, never commit .env.
TITLE_STORAGE_DATABASE_URL=postgres://postgres:test@127.0.0.1:54330/title_storage?sslmode=disable
TITLE_STORAGE_HTTP_ADDR=127.0.0.1:20230
TITLE_STORAGE_GRPC_ADDR=127.0.0.1:20231
TITLE_STORAGE_METRICS_ADDR=127.0.0.1:20232
# The account core (its gRPC on +1 of its block) and the credential this service presents there.
# The friend list (read rules) and the interaction check (write rule) come from it.
TITLE_STORAGE_CORE_ADDRESS=127.0.0.1:20001
TITLE_STORAGE_CORE_INTERNAL_KEY=
# What the console adapters (gRPC x-internal-key) and the erasure finaliser (X-Internal-Key) present here.
TITLE_STORAGE_INTERNAL_KEY=
# Defaults for a title without its own policy (UpsertTitle overrides per title).
# Bytes and objects one owner may hold per title, and the largest single object body.
# TITLE_STORAGE_QUOTA_BYTES=33554432
# TITLE_STORAGE_QUOTA_OBJECTS=256
# TITLE_STORAGE_MAX_OBJECT_BYTES=4194304
